#define ODK_LAYER        EXTRA_LAYERS_START_INDEX
#define ODK_SHIFT_LAYER (EXTRA_LAYERS_START_INDEX + 1)

&base_layer {
  display-name = "Base";
  bindings = <
    &kp BSLH   &kp Q  &kp W  &kp E    &kp R  &kp T        &kp Y    &kp U  &kp I     &kp O   &kp P      &kp LBKT
    &kp NUBS   HRM_A  HRM_S  HRM_D    HRM_F  &kp G        &kp H    HRM_J  HRM_K     HRM_L   HRM_SEMI   &kp SQT
    &kp RBKT   &kp Z  &kp X  &hyphen  &kp V  &kp B        &kp N    &kp M  &kp COMMA &odk    &kp FSLH   &kp RA(NUBS)
              LTHUMB_TUCK  LTHUMB_HOME  LTHUMB_REACH    RTHUMB_REACH  RTHUMB_HOME  RTHUMB_TUCK
  >;
};

&num_row_layer {
  display-name = "NumRow";
    bindings = <
      &kp RS(GRAVE) &kp RS(N1) &kp RS(N2) &kp RS(N3) &kp RS(N4) &kp RS(N5)       &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)    &kp LS(MINUS)
      &kp GRAVE     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5           &kp N6     &kp N7     &kp N8     &kp N9     &kp N0        &kp MINUS
      &trans        &none      &none      &none      &none      &none            &none      &none      &none      &none      &kp LS(EQUAL) &kp EQUAL
                                   &EZ_SK(RALT)  &kp RS(SPACE) &trans           &trans  &kp LS(SPACE) &EZ_SK(RALT)
  >;
};

/ {
  behaviors {
    hyphen: hyphen {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&hyphen_colon>, <S_HYPHEN>;
      mods      = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT|MOD_RALT)>;
      keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT|MOD_RALT)>;
    };	  
    hyphen_colon: hyphen_colon {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <S_HYPHEN>, <&colon>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };	
    colon: colon {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings = <&kp RA(SPACE) &kp RA(N)>;
    };
    
    odk: odk {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&odk_shift>, <&kp DOT>;
      mods      = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT|MOD_RALT)>;
      keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT|MOD_RALT)>;
    };	  
    odk_shift: odk_shift {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&osl ODK_LAYER>, <&osl ODK_SHIFT_LAYER>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };	
    
    comma: comma {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings = 
        <&kp DOT>, 
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;        
    };
    excl: excl {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings = 
        <&kp LS(DOT)>, 
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };
    
    dk: dead_key {
      compatible = "zmk,behavior-macro-two-param";
      #binding-cells = <2>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>,
        <&macro_pause_for_release>,
        <&macro_param_2to1>,
        <&kp MACRO_PLACEHOLDER>;
    };
    circumflex: circumflex {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp C>, <&kp C>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    dkc: dead_key_circumflex {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&circumflex>,
        <&macro_pause_for_release>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };    
    latin: latin { 
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RA(S)>, <&kp RA(S)>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };  
    dkl: dead_key_latin {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&latin>,
        <&macro_pause_for_release>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };  
   tilde: tilde { 
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RA(F)>, <&kp RA(F)>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };    
    dkt: dead_key_tilde {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&tilde>,
        <&macro_pause_for_release>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };  
   diaresis: diaresis { 
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RA(L)>, <&kp RA(L)>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };  
    dkd: dead_key_diaresis {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&diaresis>,
        <&macro_pause_for_release>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };  
    cedilla: cedilla {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp RA(COMMA)>, <&kp RA(COMMA)>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    dkcd: dead_key_cedilla {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings =
        <&cedilla>,
        <&macro_pause_for_release>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
    };  
  };
  
  // Extra layers defined specifically for this keymap, appended to the base keymap.
  keymap {
    compatible = "zmk,keymap";

    one_dead_key {
      display-name = "OneDeadKey";
      bindings = <
        &kp RA(BSLH)    &dkc A  &trans      &dkc E  &kp N2       &trans             &trans         &kp N9  &dkl I     &kp RA(O)    &dkc SEMI  &trans  
        &dkl RA(A)  &kp RA(A)   &dkl S  &kp RA(E)   &dkt F   &kp LS(RA(B))      &kp LS(N8)     &kp N8  &dkl K     &kp RA(L)    &kp RA(SEMI)   &trans
        &trans          &kp LS(C)   &kp RBKT    &kp LS(N3)  &kp N4       &kp RA(B)          &kp LS(RA(N))  &kp N7  &kp RA(COMMA)  &kp RA(DOT)  &dkc L     &trans
                                        &osl ODK_SHIFT_LAYER  &trans   &comma TAB            &comma ENTER  &comma SPACE &trans
      >;
    };
    one_dead_key_shift {
      display-name = "OneDeadKeyShift";
      bindings = <
        &kp LS(RA(BSLH))  &dkc LS(A)  &trans          &dkc  LS(E)  &trans          &trans       &trans  &trans  &dkl LS(I)       &kp LS(RA(O))    &dkc LS(SEMI)  &trans  
        &trans            &kp LS(RA(A))   &dkl LS(S)  &kp LS(RA(E))    &dkt LS(F)  &trans       &trans  &trans  &dkl LS(K)       &dkd LS(L)   &kp  LS(RA(SEMI))  &trans
        &trans            &trans          &kp LS(RBKT)    &trans           &trans          &trans       &trans  &trans  &dkcd LS(COMMA)  &kp LS(RA(DOT))  &dkc  LS(L)    &trans
                                                                      &trans  &trans   &excl TAB       &excl ENTER  &excl SPACE  &trans
      >;
    };
  };  
};